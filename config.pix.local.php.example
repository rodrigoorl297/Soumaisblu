/*
 * ═══════════════════════════════════════════════════════════════════════════
 * EFI PAY — QUAL API USAR?
 * ═══════════════════════════════════════════════════════════════════════════
 *
 * API COBRANÇAS (NÃO usar para proposta de crédito / PIX automático)
 *   Doc: https://dev.efipay.com.br/docs/api-cobrancas/credenciais
 *   Base: https://cobrancas.api.efipay.com.br  (homolog: cobrancas-h.api.efipay.com.br)
 *   OAuth: POST /v1/authorize  (só Client_Id + Client_Secret, sem certificado P12)
 *   Serve para: boleto, cartão, carnê, links, assinaturas boleto/cartão
 *
 * API PIX (USAR — saques + Pix Automático na proposta de crédito)
 *   Doc: https://dev.efipay.com.br/docs/api-pix/pix-automatico
 *   Base: https://pix.api.efipay.com.br  (homolog: pix-h.api.efipay.com.br)
 *   OAuth: POST /oauth/token  (Client_Id + Client_Secret + certificado .p12)
 *   Pix Automático: débito recorrente na conta do funcionário (PIC PAY, NUBANK, BMG)
 *   Escopos na app Efi: rec.read, rec.write, solicrec.read, solicrec.write, cobr.read, cobr.write
 *
 * Use a MESMA aplicação Efi já usada nos saques PIX (soublu-pix-saques), apenas habilite
 * os escopos de Pix Automático — NÃO crie app separada da API Cobranças.
 * ═══════════════════════════════════════════════════════════════════════════
 */

/* Efi Pay — API PIX (saques + Pix Automático). Troque PIX_PROVIDER para efipay em produção */
define('EFI_CLIENT_ID', 'Client_Id_...');
define('EFI_CLIENT_SECRET', 'Client_Secret_...');
define('EFI_CERT_PATH', __DIR__ . '/certs/efipay-homolog.p12');
define('EFI_CERT_PASSWORD', '');
define('EFI_SANDBOX', true);
define('EFI_PAYER_PIX_KEY', 'efipay@sejaefi.com.br');

define('EFI_WEBHOOK_URL', 'https://www.soumaisblu.com.br/api/pix_api.php?action=webhook&ignorar=');
define('EFI_WEBHOOK_SKIP_MTLS', true);

/**
 * Pix Automático (cobrança recorrente — proposta de crédito).
 * Webhook opcional para notificações de rec/solicrec/cobr.
 * Escopos OAuth necessários na app Efi: rec.read, rec.write, solicrec.read, solicrec.write, cobr.read, cobr.write
 * Documentação: https://dev.efipay.com.br/docs/api-pix/pix-automatico
 */
define('EFI_PIX_AUTO_WEBHOOK_URL', 'https://www.soumaisblu.com.br/api/credito_pix_auto_api.php?action=webhook');
